# Copie para .env e ajuste. O .env NAO e versionado.
# Tanto o docker compose quanto a API leem este arquivo.

# ---------- PostgreSQL ----------
POSTGRES_USER=kambrasil
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=kambrasil

# 5432 e 5433 ja estao ocupadas por outros projetos nesta maquina.
POSTGRES_PORT=5434

# Usada pela API. Em producao aponte para o host real e use sslmode=require.
DATABASE_URL=postgres://kambrasil:troque-esta-senha@localhost:5434/kambrasil

# ---------- API ----------
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development

# Segredo de assinatura dos tokens de sessao. Minimo 32 caracteres.
# Gere um proprio: openssl rand -hex 32
JWT_SECRET=troque-este-segredo-por-32-bytes-aleatorios

# Validade da sessao emitida no login.
SESSION_TTL_DAYS=30

# ---------- Master server ----------
# IPs autorizados a anunciar servidor de jogo (separados por virgula).
#
# O jogo nao envia credencial nenhuma no serveradd.php -- os parametros sao fixos
# no Pascal. Filtrar pela origem e a unica forma de garantir "so o nosso servidor
# aparece na lista" sem alterar o cliente.
#
# VAZIO = qualquer um pode anunciar. Use assim so em desenvolvimento.
# Em producao: ANNOUNCE_ALLOWED_IPS=127.0.0.1,203.0.113.10
ANNOUNCE_ALLOWED_IPS=

# Mensagem exibida na aba multiplayer do jogo.
MOTD=Bem-vindo ao Kam Brasil!

# Ligue (true) quando a API estiver atras de nginx/Cloudflare, senao request.ip
# devolve o IP do proxy e o allowlist acima vira inutil.
TRUST_PROXY=false
